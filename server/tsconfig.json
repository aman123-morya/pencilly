{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "esModuleInterop": true,
    "strict": true, "skipLibCheck": true, "noUnusedLocals": true,
    "resolveJsonModule": true, "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"]
}
